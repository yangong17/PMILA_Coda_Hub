# Local testing configuration. Copy to ".env" and fill in real values.
# .env is gitignored and loaded automatically on local runs.
# GitHub Actions does NOT use this file — it uses repository secrets.

# Recommended: an email or URL so site owners can reach whoever runs this.
FEEDS_CONTACT=pm-hub@example.org

# Google Sheet (leave unset to write out/*.json + *.csv instead)
GOOGLE_SHEET_ID=1T4oTJl6HhhI5un9bdkOCl-MnljlhiD35T7lzSTLdtC4
# Either the full service-account JSON on ONE line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ...or the path to the downloaded key file:
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account-key.json

# Optional: full YouTube video history via the official Data API (SETUP Part E)
# YOUTUBE_API_KEY=

# Optional knobs
# FEEDS_DELAY_SECONDS=2       pause between requests to the same site
# YOUTUBE_CHANNEL_ID=UC...    skip channel-ID discovery

# Optional: weekly health check (python -m src.linkcheck)
# CODA_API_TOKEN=            read-only token for the hub doc (SETUP Part G)
# CODA_DOC_ID=2PnUJeapkp     only if the hub moves to another doc
# ANTHROPIC_API_KEY=         lets Claude judge "Suspect" pages (SETUP Part H)
# LINKCHECK_MODEL=claude-haiku-5-5
